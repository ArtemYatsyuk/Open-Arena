# ── Server ──────────────────────────────────────────────
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:5173

# ── JWT ─────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-this-to-a-random-string
JWT_REFRESH_SECRET=change-this-to-another-random-string
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# ── Database ────────────────────────────────────────────
DATABASE_URL="file:./data.db"

# ── Cookies ─────────────────────────────────────────────
# Set SECURE_COOKIES=true when serving over HTTPS in production.
SECURE_COOKIES=false

# Frontend origin for CORS (no trailing slash). Defaults to http://localhost:5173.
CORS_ORIGIN=http://localhost:5173

# ── API Keys ────────────────────────────────────────────
# The `apiKeyEnv` field of each model in config.json names the env var
# that holds the actual key. Never put credentials directly into config.json.
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
NVIDIA_API_KEY=nvapi-your-nvidia-key-here
ATXP_API_KEY=your-atxp-key-here
OPENROUTER_API_KEY=sk-or-your-openrouter-key-here

# ── Email (SMTP) ────────────────────────────────────────
# Leave SMTP_HOST unset or set to localhost without credentials to enable
# mock mode (emails are logged to the console). Useful for development.
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@openarena.local

# ── OAuth / SSO ─────────────────────────────────────────
# Register apps at:
#   Google:   https://console.cloud.google.com/apis/credentials
#   GitHub:   https://github.com/settings/developers
#   Discord:  https://discord.com/developers/applications
#
# Callback URL format:
#   {APP_URL}/api/oauth/{provider}/callback
#
# GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=...
# GITHUB_CLIENT_ID=...
# GITHUB_CLIENT_SECRET=...
# DISCORD_CLIENT_ID=...
# DISCORD_CLIENT_SECRET=...
