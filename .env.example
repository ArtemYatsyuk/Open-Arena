# Server
PORT=4000
NODE_ENV=development

# JWT
JWT_ACCESS_SECRET=change-this-to-a-random-string
JWT_REFRESH_SECRET=change-this-to-another-random-string
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# Database
DATABASE_URL="file:./data.db"

# Cookies
# Set SECURE_COOKIES=true when serving over HTTPS in production.
SECURE_COOKIES=false

# CORS (production). Frontend origin (no trailing slash).
CORS_ORIGIN=http://localhost:5173

# API Keys (server-side only, never exposed to frontend)
# The `apiKeyEnv` field of each model in config.json names the env var below
# that holds the actual key. Never put credentials directly into config.json.
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
NVIDIA_API_KEY=nvapi-your-nvidia-key-here
ATXP_API_KEY=your-atxp-key-here
OPENROUTER_API_KEY=sk-or-your-openrouter-key-here

# Email (mock mode - logs to console)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@openarena.local
